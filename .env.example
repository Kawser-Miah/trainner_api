# --- Required ---
# PostgreSQL connection (used by the app, Alembic and tests)
# e.g. postgresql+psycopg2://user:password@localhost:5432/coach_hub
DATABASE_URL=

# Stripe (booking checkout + webhook)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional overrides (defaults from src/core/config.py) ---
HOST=0.0.0.0
PORT=8000
CLIENT_FEE_PERCENTAGE=3.00
COACH_FEE_PERCENTAGE=5.00
BOOKING_PAYMENT_TIMEOUT_MINUTES=15
